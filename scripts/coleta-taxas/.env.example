# Variáveis da coleta de taxas (cron).
# Local: copie para um .env e exporte, ou rode:
#   XANO_BASE_URL=... COLETA_SECRET=... node scripts/coleta-taxas/index.mjs
# CI: configure como GitHub Secrets (COLETA_SECRET e, opcionalmente, XANO_BASE_URL).

XANO_BASE_URL=https://x8ki-letl-twmt.n7.xano.io
XANO_API_GROUP=-qqRIakp

# Token de serviço — o MESMO valor da env var `coleta_secret` no Xano.
COLETA_SECRET=coloque-o-token-de-servico-aqui
